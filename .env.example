# Mobile (Expo) — copy to .env and fill in.
# All EXPO_PUBLIC_ vars are inlined into the JS bundle at build time; do not
# put secrets here, only the values a client is meant to hold.

# Supabase project URL.
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (safe for a client; RLS enforces isolation).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the Kandoo backend. For the Android emulator this is
# http://10.0.2.2:3000 (the AVD's alias for the host machine's localhost),
# not http://127.0.0.1:3000.
EXPO_PUBLIC_API_URL=
