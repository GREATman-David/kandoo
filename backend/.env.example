# Backend — copy to .env and fill in.
# Never commit the filled-in .env. This service-role key bypasses RLS.

# Supabase project URL (same project as the mobile app's EXPO_PUBLIC_SUPABASE_URL).
SUPABASE_URL=

# Supabase service-role key. Server-only — must never reach the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API key.
OPENAI_API_KEY=

# Chat model used for extraction/interpretation. Required, no fallback.
OPENAI_MODEL=

# Embedding model used for memory vectors.
OPENAI_EMBEDDING_MODEL=

# Google Gemini API key. Only needed when AI_PROVIDER=gemini.
GEMINI_API_KEY=

# Gemini model used for extraction and recall answers, e.g. gemini-3.6-flash.
# Required when AI_PROVIDER=gemini, no fallback.
# Embeddings always use gemini-embedding-001 at 1536 dimensions, to match the
# memories.embedding vector(1536) column.
GEMINI_MODEL=

# "openai", "gemini" or "mock". Optional, defaults to "openai".
AI_PROVIDER=

# Optional. Defaults to 3000. Railway/Render/Fly inject this in production.
PORT=
